{
  "datasets": [
    {
      "name": "f0c4c13a",
      "displayName": "golden_movies",
      "config": {
        "source": "catalog_movies.golden.golden_movies",
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ],
        "filter": "(year_from = 0 AND year_to = 9999) OR release_year BETWEEN year_from AND year_to",
        "version": "1.1",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "parameters": [
          {
            "name": "year_from",
            "dataType": "INT",
            "default": 0.0
          },
          {
            "name": "year_to",
            "dataType": "INT",
            "default": 9999.0
          }
        ]
      }
    },
    {
      "name": "2e56bcd2",
      "displayName": "director_resume",
      "queryLines": [
        "select director, count(movie_id) movies_qty,  sum(budget) total_budget, \r\n",
        "    sum(revenue) total_revenue, sum(profit) total_profit\r\n",
        "from catalog_movies.golden.golden_movies \r\n",
        "group by director"
      ]
    },
    {
      "name": "top20_profit_movies",
      "displayName": "top_20_movies_profit",
      "config": {
        "source": "SELECT title, director, release_year, budget, revenue, profit, total_minutos, vote_count, status_ticket FROM catalog_movies.golden.golden_movies WHERE profit IS NOT NULL\n  AND ((year_from = 0 AND year_to = 9999) OR release_year BETWEEN year_from AND year_to)\nORDER BY profit DESC LIMIT 20\n",
        "measures": [
          {
            "name": "total_profit",
            "expr": "SUM(profit)"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "expr": "title"
          },
          {
            "expr": "director"
          },
          {
            "expr": "release_year"
          },
          {
            "expr": "budget"
          },
          {
            "expr": "revenue"
          },
          {
            "expr": "profit"
          },
          {
            "expr": "total_minutos"
          },
          {
            "expr": "vote_count"
          },
          {
            "expr": "status_ticket"
          },
          {
            "name": "duration_hm",
            "expr": "concat(CAST(floor(total_minutos / 60) AS STRING), 'h ', lpad(CAST(total_minutos % 60 AS STRING), 2, '0'), 'm')"
          }
        ],
        "parameters": [
          {
            "name": "year_from",
            "dataType": "INT",
            "default": 0.0
          },
          {
            "name": "year_to",
            "dataType": "INT",
            "default": 9999.0
          }
        ]
      }
    },
    {
      "name": "movies_by_genre",
      "displayName": "movies_by_genre",
      "config": {
        "source": "SELECT movie_id, release_year, trim(g) AS genre FROM catalog_movies.golden.golden_movies LATERAL VIEW explode(split(genres, ',')) t AS g WHERE genres IS NOT NULL AND trim(g) <> ''\n  AND ((year_from = 0 AND year_to = 9999) OR release_year BETWEEN year_from AND year_to)\n",
        "measures": [
          {
            "name": "movies_qty",
            "expr": "COUNT(DISTINCT movie_id)"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "expr": "genre"
          },
          {
            "expr": "release_year"
          }
        ],
        "parameters": [
          {
            "name": "year_from",
            "dataType": "INT",
            "default": 0.0
          },
          {
            "name": "year_to",
            "dataType": "INT",
            "default": 9999.0
          }
        ]
      }
    },
    {
      "name": "top10_genres",
      "displayName": "top_10_genres",
      "config": {
        "source": "SELECT trim(g) AS genre, COUNT(DISTINCT movie_id) AS movies_qty FROM catalog_movies.golden.golden_movies LATERAL VIEW explode(split(genres, ',')) t AS g WHERE genres IS NOT NULL AND trim(g) <> ''\n  AND ((year_from = 0 AND year_to = 9999) OR release_year BETWEEN year_from AND year_to)\nGROUP BY trim(g) ORDER BY movies_qty DESC LIMIT 10\n",
        "measures": [
          {
            "name": "total_movies",
            "expr": "SUM(movies_qty)",
            "comment": "Total de películas por género"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "expr": "genre"
          }
        ],
        "parameters": [
          {
            "name": "year_from",
            "dataType": "INT",
            "default": 0.0
          },
          {
            "name": "year_to",
            "dataType": "INT",
            "default": 9999.0
          }
        ]
      }
    },
    {
      "name": "top10_directors_profit",
      "displayName": "top_10_directors_profit",
      "config": {
        "source": "SELECT director, SUM(profit) AS total_profit_raw, COUNT(movie_id) AS movies_qty_raw FROM catalog_movies.golden.golden_movies WHERE director IS NOT NULL AND profit IS NOT NULL\n  AND ((year_from = 0 AND year_to = 9999) OR release_year BETWEEN year_from AND year_to)\nGROUP BY director ORDER BY total_profit_raw DESC LIMIT 10\n",
        "measures": [
          {
            "name": "total_profit",
            "expr": "SUM(total_profit_raw)"
          },
          {
            "name": "movies_qty",
            "expr": "SUM(movies_qty_raw)"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "expr": "director"
          }
        ],
        "parameters": [
          {
            "name": "year_from",
            "dataType": "INT",
            "default": 0.0
          },
          {
            "name": "year_to",
            "dataType": "INT",
            "default": 9999.0
          }
        ]
      }
    },
    {
      "name": "years_list",
      "displayName": "years_list",
      "config": {
        "source": "catalog_movies.golden.golden_movies",
        "measures": [
          {
            "name": "movies_count",
            "expr": "COUNT(*)"
          }
        ],
        "filter": "release_year IS NOT NULL",
        "version": "1.1",
        "dimensions": [
          {
            "expr": "release_year"
          }
        ]
      }
    },
    {
      "name": "years_list_to",
      "displayName": "years_list_to",
      "config": {
        "source": "catalog_movies.golden.golden_movies",
        "measures": [
          {
            "name": "movies_count",
            "expr": "COUNT(*)"
          }
        ],
        "filter": "release_year IS NOT NULL",
        "version": "1.1",
        "dimensions": [
          {
            "expr": "release_year"
          }
        ]
      }
    }
  ],
